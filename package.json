{
    "name": "sashabd",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Sashabd - LED display sales, installation, and support in Bangladesh",
    "scripts": {
        "predev": "node scripts/generate-image-variants.mjs",
        "dev": "next dev",
        "prebuild": "node scripts/generate-image-variants.mjs",
        "build": "next build",
        "build:package": "powershell -ExecutionPolicy Bypass -File scripts/build-static-package.ps1",
        "start": "next start",
        "serve:static": "node scripts/serve-static.mjs --port=4173",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs",
        "seo:audit": "node scripts/seo-audit.mjs",
        "seo:audit:local": "node scripts/seo-audit.mjs --base=http://127.0.0.1:4173 --expected-origin=https://sashabd.com --output=reports/seo-audit.json",
        "seo:audit:production": "node scripts/seo-audit.mjs --base=https://sashabd.com --expected-origin=https://sashabd.com --output=reports/production-seo-audit.json",
        "indexnow:submit": "node scripts/indexnow-submit.mjs"
    },
    "dependencies": {
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "sharp": "^0.34.5",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
