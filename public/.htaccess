DirectoryIndex index.html
ErrorDocument 404 /404.html

AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .htm
  AddType "text/html; charset=UTF-8" .html .htm
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header always set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------
  # Legacy asset URLs
  # ------------------------------
  # Assets now live under topic-based /assets folders. Keep previously
  # published image URLs working for search engines, caches and old links.
  RewriteRule ^images/about/(.*)$ /assets/about/$1 [R=301,L,NE]
  RewriteRule ^images/accessories/(.*)$ /assets/led-display/accessories/$1 [R=301,L,NE]
  RewriteRule ^images/blog/(.*)$ /assets/blog/$1 [R=301,L,NE]
  RewriteRule "^images/complete package/(.*)$" /assets/conference-system/packages/$1 [R=301,L,NE]
  RewriteRule "^images/Conference system/(.*)$" /assets/conference-system/products/core/$1 [R=301,L,NE]
  RewriteRule ^images/conference_landing/(.*)$ /assets/conference-system/landing/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_products/bosch_products/(.*)$ /assets/conference-system/products/brands/bosch/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_products/cmx_products/(.*)$ /assets/conference-system/products/brands/cmx/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_products/honeywell_products/(.*)$ /assets/conference-system/products/brands/honeywell/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_products/spon_products/(.*)$ /assets/conference-system/products/brands/spon/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_products/toa_products/(.*)$ /assets/conference-system/products/brands/toa/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_products/(.*)$ /assets/conference-system/products/brands/$1 [R=301,L,NE]
  RewriteRule ^images/conference_system_projects/(.*)$ /assets/conference-system/projects/$1 [R=301,L,NE]
  RewriteRule ^images/contact/(.*)$ /assets/contact/$1 [R=301,L,NE]
  RewriteRule ^images/controller/(.*)$ /assets/led-display/controllers/$1 [R=301,L,NE]
  RewriteRule ^images/home_hero/(.*)$ /assets/home/hero/$1 [R=301,L,NE]
  RewriteRule ^images/indoor/(.*)$ /assets/led-display/indoor/$1 [R=301,L,NE]
  RewriteRule "^images/Interactive flat panel/(.*)$" /assets/control-systems/interactive-flat-panel/products/$1 [R=301,L,NE]
  RewriteRule ^images/interactive-flat-panel/(.*)$ /assets/control-systems/interactive-flat-panel/landing/$1 [R=301,L,NE]
  RewriteRule "^images/led hero/(.*)$" /assets/led-display/heroes/$1 [R=301,L,NE]
  RewriteRule ^images/outdoor/(.*)$ /assets/led-display/outdoor/$1 [R=301,L,NE]
  RewriteRule ^images/PA/(.*)$ /assets/control-systems/pa-system/products/$1 [R=301,L,NE]
  RewriteRule ^images/podium/(.*)$ /assets/control-systems/digital-podium/products/$1 [R=301,L,NE]
  RewriteRule ^images/power-supply/(.*)$ /assets/led-display/power-supplies/$1 [R=301,L,NE]
  RewriteRule ^images/project-page/(.*)$ /assets/projects/$1 [R=301,L,NE]
  RewriteRule ^images/receiving-card/(.*)$ /assets/led-display/receiving-cards/$1 [R=301,L,NE]
  RewriteRule ^images/rental/(.*)$ /assets/led-display/rental/$1 [R=301,L,NE]
  RewriteRule ^images/Turnstile/(.*)$ /assets/control-systems/turnstile/products/$1 [R=301,L,NE]
  RewriteRule ^images/brands/audio/(.*)$ /assets/brands/audio/$1 [R=301,L,NE]
  RewriteRule ^images/brands/(.*)$ /assets/brands/led-display/$1 [R=301,L,NE]

  RewriteRule ^images/logo/(acc\.webp|ansar\.webp|bgb\.webp|bhbfc-logo-final\.webp|bpatc\.webp|bpsc\.webp|brta\.webp|BSCIC\.webp|bsfic\.webp|caab\.webp|dncc\.webp|dscc\.webp|ecs\.webp|fire-service\.webp|Health-and-family-welfare\.webp|nbr\.webp|parjatan\.webp|passport\.webp|sonali-bank\.webp|ugc\.webp)$ /assets/clients/organizations/$1 [R=301,L,NE]
  RewriteRule ^images/logo/(absen\.webp|aoto-electronics\.webp|colorlight\.webp|g-energy\.webp|lampro\.webp|leyard\.webp|liantronics\.png|mean-well\.webp|mugnee\.webp|novastar\.webp|unilumin\.webp)$ /assets/brands/led-display/$1 [R=301,L,NE]
  RewriteRule ^images/logo/digital-podium\.svg$ /assets/control-systems/digital-podium/digital-podium.svg [R=301,L,NE]
  RewriteRule ^images/logo/PA-sound\.webp$ /assets/control-systems/pa-system/pa-sound.webp [R=301,L,NE]
  RewriteRule ^images/logo/turnstile-gate-common\.webp$ /assets/control-systems/turnstile/turnstile-gate-common.webp [R=301,L,NE]

  RewriteRule ^images/hero\.webp$ /assets/shared/hero.webp [R=301,L,NE]
  RewriteRule "^images/digital -podium-hero\.webp$" /assets/control-systems/digital-podium/digital-podium-hero.webp [R=301,L,NE]
  RewriteRule ^images/interactive-flat-panal-hero\.webp$ /assets/control-systems/interactive-flat-panel/interactive-flat-panel-hero.webp [R=301,L,NE]
  RewriteRule ^images/turnstile-entrance-hero-v2\.webp$ /assets/control-systems/turnstile/turnstile-entrance-hero-v2.webp [R=301,L,NE]
  RewriteRule ^images/turnstile-gate-hero\.webp$ /assets/control-systems/turnstile/turnstile-gate-hero.webp [R=301,L,NE]
  RewriteRule ^images/Turnstile-gate-System\.webp$ /assets/control-systems/turnstile/turnstile-gate-system.webp [R=301,L,NE]
  RewriteRule ^sasha-corporation-final-l\.webp$ /assets/brand/sasha/sasha-corporation-final-l.webp [R=301,L,NE]
  RewriteRule ^sasha-corporation-after-scroll\.png$ /assets/brand/sasha/sasha-corporation-after-scroll.png [R=301,L,NE]

  # ------------------------------
  # Force non-www canonical
  # ------------------------------
  RewriteCond %{HTTP_HOST} ^www\.sashabd\.com$ [NC]
  RewriteRule ^ https://sashabd.com%{REQUEST_URI} [R=301,L]

  # ------------------------------
  # Force HTTPS canonical (proxy-safe)
  # ------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ------------------------------
  # Handle clean URLs (remove .html)
  # ------------------------------
  # Redirect /path.html to /path/ (matches next.config trailingSlash: true)
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # Serve /path/ as /path/index.html (handled by DirectoryIndex usually, but let's be explicit)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}index.html -f
  RewriteRule ^(.*)$ $1index.html [L]

  # Next static export RSC payloads may be requested as dotted paths such as
  # `__next.contact.__PAGE__.txt` while the exported files live in nested dirs.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?(__next\.[^.]+)\.(.+\.txt)$ $1$2/$3 [N]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/__next\.[^/]+/.+)\.([^/.]+\.txt)$ $1/$2 [N]

  # ------------------------------
  # Canonical short URL redirects
  # ------------------------------

  # Control Systems landing removed; PA Sound System moved to top-level URL
  RewriteRule ^control-systems/?$ /pa-system/ [R=301,L]
  RewriteRule ^control-systems/pa-system/?$ /pa-system/ [R=301,L]
  RewriteRule ^control-systems/pa-system/([^/]+)/?$ /pa-system/$1/ [R=301,L]
  RewriteRule ^control-systems/digital-podium/?$ /digital-podium/ [R=301,L]
  RewriteRule ^control-systems/digital-podium/([^/]+)/?$ /digital-podium/$1/ [R=301,L]
  RewriteRule ^control-systems/interactive-flat-panel/?$ /interactive-flat-panel/ [R=301,L]
  RewriteRule ^control-systems/interactive-flat-panel/([^/]+)/?$ /interactive-flat-panel/$1/ [R=301,L]
  RewriteRule ^control-systems/turnstile-gate-system/?$ /turnstile-gate/ [R=301,L]
  RewriteRule ^control-systems/turnstile-gate-system/([^/]+)/?$ /turnstile-gate/$1/ [R=301,L]

  # Indoor (legacy aliases first)
  RewriteRule ^led-display/indoor/p4-indoor-led-display/?$ /led-display/indoor-led/p4-indoor-led-display-module/ [R=301,L]
  RewriteRule ^led-display/indoor/p5-indoor-led-display/?$ /led-display/indoor-led/ [R=301,L]

  RewriteRule ^led-display/indoor/?$ /led-display/indoor-led/ [R=301,L]
  RewriteRule ^led-display/indoor/([^/]+)/?$ /led-display/indoor-led/$1/ [R=301,L]

  # Top-level indoor-led legacy
  RewriteRule ^indoor-led/?$ /led-display/indoor-led/ [R=301,L]
  RewriteRule ^indoor-led/([^/]+)/?$ /led-display/indoor-led/$1/ [R=301,L]

  # Rental
  RewriteRule ^led-display/rental/?$ /led-display/rental-display/ [R=301,L]
  RewriteRule ^led-display/rental/([^/]+)/?$ /led-display/rental-display/$1/ [R=301,L]

  # Top-level rental-display legacy
  RewriteRule ^rental-display/?$ /led-display/rental-display/ [R=301,L]
  RewriteRule ^rental-display/([^/]+)/?$ /led-display/rental-display/$1/ [R=301,L]

  # Price guide
  RewriteRule ^led-display/price-guide/?$ /led-display/ [R=301,L]
  RewriteRule ^led-display/price-guide-bangladesh/?$ /led-display/ [R=301,L]
  RewriteRule ^led-display/led-display-screen-price-in-bangladesh/?$ /led-display/ [R=301,L]

  # Rent guide
  RewriteRule ^led-display/led-screen-rent-in-bangladesh/?$ /led-display/rent-guide/ [R=301,L]

  # Cluster page slug tweaks (minimum change)
  RewriteRule ^led-display/digital-led-display/?$ /led-display/ [R=301,L]
  RewriteRule ^led-display/digital-led-display-guide/?$ /led-display/ [R=301,L]
  RewriteRule ^led-display/indoor-led-video-wall-guide/?$ /led-display/indoor-led-video-wall-bangladesh/ [R=301,L]
  RewriteRule ^led-display/indoor-led-video-wall/?$ /led-display/indoor-led-video-wall-bangladesh/ [R=301,L]
  RewriteRule ^led-display/rent/?$ /led-display/rent-guide/ [R=301,L]

  # Blog slug changes
  RewriteRule ^blog/led-display-vs-lcd-video-wall/?$ /blog/led-vs-lcd-video-wall/ [R=301,L]
  RewriteRule ^blog/best-led-video-wall-solutions-for-corporate-offices/?$ /blog/best-corporate-office-led-video-wall/ [R=301,L]

  # Huidu brand and its one conference video processor removed from Conference System
  RewriteRule ^conference-system/huidu-hd-vp950-conference-video-processor/?$ /conference-system/video-conference-system/ [R=301,L]

  # Conference products previously published inside the PA catalog
  RewriteRule ^pa-system/bosch-ccs-900-ultra-conference-system-unit/?$ /conference-system/bosch-ccs-900-ultra-conference-system-unit/ [R=301,L]
  RewriteRule ^pa-system/bosch-ccs-cu-conference-control-power-unit/?$ /conference-system/bosch-ccs-cu-conference-control-power-unit/ [R=301,L]
  RewriteRule ^pa-system/conference-discussion-system-chairman-delegate-set/?$ /conference-system/complete-package/ [R=301,L]
  RewriteRule ^pa-system/wireless-conference-microphone-system/?$ /conference-system/wireless-conference-system/ [R=301,L]

  # Services slug change
  RewriteRule ^services/?$ /services-support/ [R=301,L]

  # ------------------------------
  # Legacy /products -> /led-display (keep old links working)
  # ------------------------------
  RewriteRule ^products/?$ /led-display/ [R=301,L]

  RewriteRule ^products/indoor/?$ /led-display/indoor-led/ [R=301,L]
  RewriteRule ^products/indoor/([^/]+)/?$ /led-display/indoor-led/$1/ [R=301,L]

  RewriteRule ^products/outdoor/?$ /led-display/outdoor/ [R=301,L]
  RewriteRule ^products/outdoor/([^/]+)/?$ /led-display/outdoor/$1/ [R=301,L]

  RewriteRule ^products/rental/?$ /led-display/rental-display/ [R=301,L]
  RewriteRule ^products/rental/([^/]+)/?$ /led-display/rental-display/$1/ [R=301,L]

  RewriteRule ^products/accessories/?$ /led-display/accessories/ [R=301,L]
  RewriteRule ^products/accessories/(controller|power-supply|receiving-card|led-accessories)/?$ /led-display/accessories/$1/ [R=301,L]
  RewriteRule ^products/accessories/(controller|power-supply|receiving-card|led-accessories)/([^/]+)/?$ /led-display/accessories/$1/$2/ [R=301,L]

  # ------------------------------
  # URL hygiene (static export)
  # ------------------------------

  # Strip useless `?m=...` query variants (GSC "Alternative page with proper canonical tag")
  # Root URL is the main offender in GSC, so keep a direct canonical redirect for LiteSpeed/Apache.
  RewriteCond %{REQUEST_URI} ^/$
  RewriteCond %{QUERY_STRING} ^m=[^&]+$ [NC]
  RewriteRule ^ https://sashabd.com/? [R=301,L]

  # For other paths, remove `?m=` only when it is the only query param.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{QUERY_STRING} ^m=[^&]+$ [NC]
  RewriteRule ^ %{REQUEST_URI}? [R=301,L]

  # Remove /index.html (single canonical)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Legacy blog hub slug -> canonical blog hub
  RewriteRule ^blog-and-case-study/?$ /blog/ [R=301,L]

  # Enforce trailing slash for non-file URLs (matches next.config.ts trailingSlash: true)
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteRule ^ %{REQUEST_URI}/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Long-cache for versioned/static assets
  <FilesMatch "\.(?:css|js|mjs|json|map|woff2|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  <FilesMatch "^(?!robots\.txt$).*\.(?:txt)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # HTML should revalidate (Cloudflare can still cache at edge if configured)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "^(?:sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
